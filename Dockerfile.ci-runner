FROM node:24.20.0-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git tar chromium fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g npm@11.19.0
ENV CHROMIUM_PATH=/usr/bin/chromium
WORKDIR /opt/webforge-runner
COPY scripts/remote-ci-runner.mjs /opt/webforge-runner/remote-ci-runner.mjs
CMD ["node","/opt/webforge-runner/remote-ci-runner.mjs"]
